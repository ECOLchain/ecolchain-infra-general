# ------------------------------------------------------------------
# DNS/TLS — api-dev/api-prod no Cloudflare (mesmo provider do repo),
# registros A proxied apontando para o IP público do LB.
# TLS: Cloudflare Full (strict) — o LB apresenta certificado da
# Cloudflare Origin CA (gratuito, só válido quando proxied).
# ------------------------------------------------------------------
resource "tls_private_key" "origin" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "tls_cert_request" "origin" {
  private_key_pem = tls_private_key.origin.private_key_pem
  dns_names       = [var.api_dev_hostname, var.api_prod_hostname]

  subject {
    common_name = var.api_prod_hostname
  }
}

resource "cloudflare_origin_ca_certificate" "api" {
  csr                = tls_cert_request.origin.cert_request_pem
  hostnames          = [var.api_dev_hostname, var.api_prod_hostname]
  request_type       = "origin-rsa"
  requested_validity = 5475 # ~15 anos (máximo do Origin CA)
}

