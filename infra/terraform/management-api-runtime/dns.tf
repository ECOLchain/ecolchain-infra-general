resource "cloudflare_dns_record" "api_dev" {
  zone_id = var.cloudflare_zone_id
  name    = var.api_dev_hostname
  type    = "A"
  content = local.lb_public_ip
  proxied = true
  ttl     = 1 # automático quando proxied
}

resource "cloudflare_dns_record" "api_prod" {
  zone_id = var.cloudflare_zone_id
  name    = var.api_prod_hostname
  type    = "A"
  content = local.lb_public_ip
  proxied = true
  ttl     = 1
}
